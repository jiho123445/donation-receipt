rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function isSuperAdmin() {
      return signedIn() && request.auth.token.super_admin == true;
    }

    match /organizations/{orgId} { allow read: if signedIn(); allow create, update: if isAdmin(); allow delete: if isSuperAdmin(); }
    match /donors/{donorId} { allow read: if signedIn(); allow create, update: if isAdmin(); allow delete: if isSuperAdmin(); }
    match /members/{memberId} { allow read: if signedIn(); allow create, update: if isAdmin(); allow delete: if isSuperAdmin(); }
    match /donations/{donationId} { allow read: if signedIn(); allow create, update: if isAdmin(); allow delete: if isSuperAdmin(); }
    match /membershipPayments/{paymentId} { allow read: if signedIn(); allow create, update: if isAdmin(); allow delete: if isSuperAdmin(); }
    match /awards/{awardId} { allow read: if signedIn(); allow create, update: if isAdmin(); allow delete: if isSuperAdmin(); }
    match /receipts/{receiptId} { allow read: if signedIn(); allow create, update: if isAdmin(); allow delete: if isSuperAdmin(); }
    match /issuedReceipts/{receiptId} { allow read: if signedIn(); allow create, update: if isAdmin(); allow delete: if isSuperAdmin(); }
    match /counters/{taxYear} { allow read: if signedIn(); allow create, update: if isAdmin(); allow delete: if isSuperAdmin(); }
    match /importedFiles/{fileHash} { allow read: if signedIn(); allow create, update: if isAdmin(); allow delete: if isSuperAdmin(); }

    // 감사로그는 클라이언트 변조를 방지하기 위해 직접 읽기/쓰기 차단.
    // 필요 시 Cloud Functions/Admin SDK로 기록하세요.
    match /auditLogs/{logId} { allow read: if isSuperAdmin(); allow write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}

// V5 member master: keep members under authenticated admin access.
// If your rules already contain a catch-all authenticated rule this is redundant.

rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function isAdmin(){return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));}
  match /admins/{uid}{allow read:if signedIn()&&request.auth.uid==uid;allow write:if false;}
  match /organizations/{id}{allow read,write:if isAdmin();}
  match /donors/{id}{allow read,write:if isAdmin();}
  match /donations/{id}{allow read,write:if isAdmin();}
  match /receipts/{id}{allow read,write:if isAdmin();}
  match /issuedReceipts/{id}{allow read,write:if isAdmin();}
  match /counters/{id}{allow read,write:if isAdmin();}
  match /{document=**}{allow read,write:if false;}
 }
}

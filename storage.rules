rules_version = '2';

// Firebase Storage 보안 규칙
// - receipts/ 경로: 로그인한 재단 관리자만 업로드 가능, 다운로드 링크는
//   토큰 기반 URL(getDownloadURL)로만 열람 가능하도록 읽기는 인증 없이 허용합니다.
//   (카카오톡 공유하기로 전달된 링크를 받은 기부자 본인이 별도 로그인 없이
//   PDF를 확인할 수 있어야 하기 때문입니다. URL 자체가 추측 불가능한 토큰을
//   포함하므로 공개 디렉터리 나열은 불가능합니다.)
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.resource.size < 15 * 1024 * 1024
                    && request.resource.contentType == 'application/pdf';
      allow delete: if request.auth != null;
    }

    // 기본값: 그 외 모든 경로는 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
